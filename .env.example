# Backend - MT5
CUSTOM_USER=admin
PASSWORD=1234
VNC_DOMAIN=mt5vnc.cherdon.autos
API_DOMAIN=mt5api.cherdon.autos
MT5_API_PORT=5001
N8N_DOMAIN=mt5n8n.cherdon.autos

# Traefik
TRAEFIK_DOMAIN=mt5traefik.cherdon.autos
TRAEFIK_USERNAME=admin
TRAEFIK_HASHED_PASSWORD=
ACME_EMAIL=admin@cherdon.autos

# Postgres
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=1234

# n8n
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=$POSTGRES_DB
DB_POSTGRESDB_USER=$POSTGRES_USER
DB_POSTGRESDB_PASSWORD=$POSTGRES_PASSWORD

# Monitoring
GRAFANA_DOMAIN=mt5grafana.cherdon.autos

# Backend - Django
MT5_API_URL=http://mt5:5001
DJANGO_DOMAIN=mt5django.cherdon.autos
N8N_WEBHOOK_URL=https://mt5n8n.cherdon.autos/webhook/xxx
LOG_VOLUME=/mnt/volume_sgp1_01/logs

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis
REDIS_URL=redis://redis:6379/1

# Binance
API_KEY_BINANCE=xxx
API_SECRET_BINANCE=xxx

# Control API
CONTROL_API_DOMAIN=mt5control-api.cherdon.autos
CONTROL_API_PORT=5002
HOLDER_NAME=example-holder

# Quant / Arbitrage
ENABLE_QUANT_BOOTSTRAP=false
PAIR_INDEX=0
CONTRACT_SIZE=100
MINIMUM_TRADE_AMOUNT=1

# Frontend
FRONTEND_DOMAIN=mt5frontend.cherdon.autos
VITE_API_BASE_URL=https://mt5control-api.cherdon.autos
VITE_API_BASE_URL_2=https://mt5control-api.cherdon.autos
VITE_API_BASE_URL_3=https://mt5control-api.cherdon.autos
VITE_API_BASE_URL_DEV=http://localhost:5002